{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "microphone=(self), camera=(), geolocation=()"
        }
      ]
    }
  ],
  "functions": {
    "api/teller.js": {
      "includeFiles": "{node_modules/ffmpeg-static/ffmpeg,assets/fonts/**}"
    },
    "api/studio.js": {
      "includeFiles": "{node_modules/ffmpeg-static/ffmpeg,assets/fonts/**}"
    }
  }
}
