# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# ElevenLabs → Developers → API Keys (needs Speech to Text, and Text to Speech for the video narrator)
ELEVENLABS_API_KEY=your-elevenlabs-key

# Anthropic Console → API Keys (writes stories and comic scripts)
ANTHROPIC_API_KEY=your-anthropic-key

# Any long password you choose, for the studio page (studio.html)
STUDIO_PASSWORD=choose-a-long-password

# Optional
# CLAUDE_MODEL=claude-sonnet-5-5
# ELEVENLABS_STT_MODEL=scribe_v2
# AUTO_VIDEO=off                    # don't make the video automatically after the comic is drawn
# ELEVENLABS_TTS_MODEL=eleven_v3    # narrator model (eleven_v3 speaks Kazakh, Russian and English)
# ELEVENLABS_VOICE_FEMALE=XrExE9yKIg1WjnnlVkGX
# ELEVENLABS_VOICE_MALE=JBFqnCBsd6RMkjVDRZzb
# PUBLIC_BASE_URL=https://your-domain.com
